{
  "name": "gso-village",
  "version": "0.1.0",
  "private": true,
  "description": "A watch-only pixel village of Greensboro, NC, driven by live local data.",
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "ingest": "node scripts/ingest.mjs",
    "civic": "node scripts/civic.mjs",
    "fetch": "node scripts/fetch-digests.mjs",
    "feeds": "node scripts/fetch-feeds.mjs",
    "dev": "node scripts/ingest.mjs && node scripts/serve.mjs",
    "serve": "node scripts/serve.mjs",
    "crime": "node scripts/fetch-crime.mjs",
    "test": "node --test test/*.test.mjs"
  }
}
